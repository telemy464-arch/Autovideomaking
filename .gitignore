# ============================================
# Git Ignore - Mizan AI Video Studio
# ============================================

# Security: Never commit private API keys
.env
*.env.local

# Virtual Environments
.venv/
venv/
ENV/
env/

# Python Cache
__pycache__/
*.py[cod]
*.class
.pytest_cache/

# Large Rendered Videos & Cache Files
output/*.mp4
output/*.wav
output/*.mp3
temp/*
!temp/.gitkeep
assets/temp/*

# Large Binary / Offline Packages (too big for GitHub)
bin/
runtime/
offline_wheels/
installers/
installer_output/

# Compiled Executables (large, platform-specific)
*.exe

# OS & Editor Files
.vscode/
.idea/
.DS_Store
Thumbs.db
